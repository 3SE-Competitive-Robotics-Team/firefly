[Unit]
Description=Firefly onboard processes

[Service]
Type=simple
WorkingDirectory=/opt/firefly
Environment=RUST_LOG=info
ExecStart=/opt/firefly/bin/ffctl process supervise --config /opt/firefly/configs/processes.toml
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
